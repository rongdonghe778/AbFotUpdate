<Window x:Class="AB.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="CM2206 固件升级"
        Height="620"
        Width="700"
        MinHeight="540"
        MinWidth="680"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#F3F5F8"
        AllowDrop="True"
        DragOver="Window_FileDragOver"
        Drop="Window_FileDrop"
        x:Name="RootWindow">
    <Window.Resources>
        <Style TargetType="GroupBox">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#DDE3EA"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Height" Value="28"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="BorderBrush" Value="#C5CDD6"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        <Style x:Key="CmdBox" TargetType="TextBox" BasedOn="{StaticResource FieldBox}">
            <Setter Property="FontFamily" Value="Consolas"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Height" Value="26"/>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Background" Value="#EEF2F6"/>
            <Setter Property="BorderBrush" Value="#C5CDD6"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="#1565C0"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#0D47A1"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B0BEC5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CmdButton" TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
            <Setter Property="Height" Value="26"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#6B7785"/>
            <Setter Property="Margin" Value="0,8,0,6"/>
        </Style>
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#1A3A6B"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#E81123"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border x:Name="TitleBar" DockPanel.Dock="Top" Background="#001A41" Height="48"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0"
                            IsHitTestVisible="False">
                    <Image Source="Assets/onway.png" Height="32" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock x:Name="TitleAppText" Text="CM2206 固件升级" Foreground="White" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="12,0,0,0"/>
                    <TextBlock x:Name="TitleVersionText" Foreground="#8FA3C1" FontSize="12"
                               VerticalAlignment="Center" Margin="10,2,0,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource CaptionButton}" Content="─" Click="CaptionMinimize_Click"/>
                    <Button x:Name="BtnCaptionMax" Style="{StaticResource CaptionButton}" Content="☐" Click="CaptionMax_Click"/>
                    <Button Style="{StaticResource CaptionCloseButton}" Content="✕" Click="CaptionClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Grid x:Name="UpgradePage" Grid.Column="0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <GroupBox Grid.Row="0" Header="1. 连接 Dongle">
                <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="70"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="产品" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Grid Grid.Column="1" MinWidth="140">
                                <ComboBox x:Name="ProductComboBox" Height="28"/>
                                <TextBlock x:Name="ProductDisplayOverlay"
                                           VerticalAlignment="Center"
                                           Margin="8,0,22,0"
                                           IsHitTestVisible="False"
                                           Visibility="Collapsed"/>
                            </Grid>
                            <TextBlock Grid.Column="2" Text="VID" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#6B7785"/>
                            <TextBox x:Name="infoVid" Grid.Column="3" Style="{StaticResource FieldBox}" Text="38A6"
                                     FontFamily="Consolas" IsReadOnly="True" Background="#F7F9FB"/>
                            <TextBlock Grid.Column="4" Text="PID" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#6B7785"/>
                            <TextBox x:Name="infoPid" Grid.Column="5" Style="{StaticResource FieldBox}" Text=""
                                     FontFamily="Consolas" IsReadOnly="True" Background="#F7F9FB"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="#C0392B" Margin="0,0,8,0"/>
                            <TextBlock x:Name="_TextDeviceStatus" Text="未连接" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                    <Grid Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Top">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="100"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="8"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Button x:Name="BtnBatchUpgrade" Grid.Row="0" Grid.Column="0" Content="批量升级"
                                Style="{StaticResource SecondaryButton}" Click="BtnBatchUpgrade_Click"/>
                        <Button x:Name="BtnFindDevice" Grid.Row="0" Grid.Column="2" Content="查找并连接"
                                Style="{StaticResource SecondaryButton}" Click="BtnFindDevice_Click"/>
                        <Button x:Name="BtnProdTest" Grid.Row="2" Grid.Column="0" Content="产测模式"
                                Style="{StaticResource SecondaryButton}" Click="BtnProdTest_Click"/>
                        <Button x:Name="BtnUsbDevices" Grid.Row="4" Grid.Column="0" Content="USB 设备"
                                Style="{StaticResource SecondaryButton}" Click="BtnUsbDevices_Click"/>
                        <Button x:Name="BtnToggleCommand" Grid.Row="4" Grid.Column="2" Content="指令控制"
                                Style="{StaticResource SecondaryButton}" Click="BtnToggleCommand_Click"/>
                    </Grid>
                </Grid>
                    <TextBlock Margin="0,8,0,0" Foreground="#7A8694" FontSize="12"
                               Text="默认自动识别已连接的 Dongle。耳机通过 Dongle 经 2.4G 升级，请保持无线已连接。"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="1" Header="2. 选择固件">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="_TextFilePath" Style="{StaticResource FieldBox}" IsReadOnly="True"
                             Margin="0,0,8,0" Background="#F7F9FB"/>
                    <Button Grid.Column="1" x:Name="BtnReadFile" Content="浏览..." Width="90"
                            Style="{StaticResource SecondaryButton}" Click="BtnReadFile_Click"/>
                </Grid>
            </GroupBox>

            <GroupBox Grid.Row="2" Header="3. 升级">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="ProgressBarOta" Height="22" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#1565C0"/>
                        <TextBlock x:Name="_TextPercent" Grid.Column="1" Text="0%" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                    <TextBlock x:Name="_TextOtaStatus" Text="等待开始" Margin="0,6,0,10" Foreground="#6B7785"/>
                    <Button x:Name="BtnSendData" Content="开始升级" Style="{StaticResource PrimaryButton}"
                            Click="BtnSendData_Click" IsEnabled="False"/>
                    <TextBlock x:Name="_TextOtaHint" Margin="0,8,0,0" FontSize="12" Foreground="#7A8694"
                               Text="请先连接 Dongle 并选择固件文件"/>
                </StackPanel>
            </GroupBox>

            <GroupBox Grid.Row="3" Header="日志" Margin="0">
                <TextBox x:Name="TxtLog"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         Background="#FAFBFC"/>
            </GroupBox>

            <Popup x:Name="DeviceSelectionPopup"
                   PlacementTarget="{Binding ElementName=BtnFindDevice}"
                   Placement="Bottom"
                   IsOpen="False"
                   StaysOpen="False"
                   Width="480">
                <Border Background="White" BorderBrush="#C5CDD6" BorderThickness="1" Padding="10" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="选择要连接的 Dongle" Margin="0,0,0,8" FontWeight="SemiBold"/>
                        <ComboBox x:Name="DeviceComboBox" Height="28" DisplayMemberPath="Display"
                                  SelectionChanged="DeviceComboBox_SelectionChanged"/>
                        <Button Content="连接" Margin="0,10,0,0" Height="28" Click="DeviceSelectionPopup_OkButton_Click"/>
                    </StackPanel>
                </Border>
            </Popup>
        </Grid>

        <Grid x:Name="BatchUpgradePage" Grid.Column="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="160"/>
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="返回升级" Width="100" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}" Click="BtnLeaveBatchUpgrade_Click"/>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="批量升级" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8694" Margin="0,6,0,0"
                                   Text="先选择固件。之后每插入一台 Dongle 会自动开始升级。升级完成后拔出，再插入下一台。"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="12" Margin="0,0,0,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="BatchFilePath" Style="{StaticResource FieldBox}" IsReadOnly="True"
                             Margin="0,0,8,0" Background="#F7F9FB"/>
                    <Button Grid.Column="1" Content="浏览..." Width="90"
                            Style="{StaticResource SecondaryButton}" Click="BtnReadFile_Click"/>
                </Grid>
            </Border>
            <Border Grid.Row="2" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center" Margin="24">
                    <Ellipse x:Name="BatchDot" Width="28" Height="28" Fill="#C0392B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="BatchStatusText" Text="等待插入 Dongle" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock x:Name="BatchDetailText" Text="请先选择固件" Foreground="#6B7785"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                    <Grid Margin="40,18,40,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="52"/>
                        </Grid.ColumnDefinitions>
                        <ProgressBar x:Name="BatchProgress" Height="22" Minimum="0" Maximum="100" Value="0"
                                     Foreground="#1565C0"/>
                        <TextBlock x:Name="BatchPercent" Grid.Column="1" Text="0%" VerticalAlignment="Center"
                                   HorizontalAlignment="Right" FontWeight="SemiBold"/>
                    </Grid>
                </StackPanel>
            </Border>
            <GroupBox Grid.Row="3" Header="记录" Margin="0">
                <TextBox x:Name="BatchLog"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         Background="#FAFBFC"/>
            </GroupBox>
        </Grid>

        <Grid x:Name="ProdTestPage" Grid.Column="0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="180"/>
            </Grid.RowDefinitions>
            <Border Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="16" Margin="0,0,0,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="返回升级" Width="100" VerticalAlignment="Center"
                            Style="{StaticResource SecondaryButton}" Click="BtnLeaveProdTest_Click"/>
                    <StackPanel Margin="0,0,16,0">
                        <TextBlock Text="产测模式" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Foreground="#7A8694" Margin="0,6,0,0"
                                   Text="插入 Dongle 后自动识别，并发送进入 DUT。设备随后会从电脑上消失，这是正常现象。拔出后再插入下一台。"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Row="1" Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Margin="0,0,0,10">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                    <Ellipse x:Name="ProdTestDot" Width="28" Height="28" Fill="#C0392B" HorizontalAlignment="Center"/>
                    <TextBlock x:Name="ProdTestStatusText" Text="等待插入 Dongle" FontSize="28" FontWeight="SemiBold"
                               HorizontalAlignment="Center" Margin="0,16,0,8"/>
                    <TextBlock x:Name="ProdTestDetailText" Text="支持 A7 MAX、A10、CM2206" Foreground="#6B7785"
                               HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
            </Border>
            <GroupBox Grid.Row="2" Header="记录" Margin="0">
                <TextBox x:Name="ProdTestLog"
                         VerticalScrollBarVisibility="Auto"
                         TextWrapping="Wrap"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         FontFamily="Consolas"
                         FontSize="12"
                         BorderThickness="0"
                         Background="#FAFBFC"/>
            </GroupBox>
        </Grid>

        <Border x:Name="CommandPanel" Grid.Column="1" Width="480" Margin="12,0,0,0" Visibility="Collapsed"
                Background="White" BorderBrush="#DDE3EA" BorderThickness="1" Padding="12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="指令控制" FontSize="15" FontWeight="SemiBold"/>
                    <TextBlock TextWrapping="Wrap" Foreground="#7A8694" FontSize="11" Margin="0,4,0,4"
                               Text="TAGT(47 4D) + opcode + length + data"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="产测 / DUT"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info0101" Style="{StaticResource CmdBox}" Text="47 4D 01 01 01" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="进入产测模式" Style="{StaticResource CmdButton}" Click="ButtonGoTest_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info0100" Style="{StaticResource CmdBox}" Text="47 4D 01 01 00" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="退出产测模式" Style="{StaticResource CmdButton}" Click="ButtonOutTest_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info0201" Style="{StaticResource CmdBox}" Text="47 4D 02 01 01" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="进入Dut模式" Style="{StaticResource CmdButton}" Click="ButtonGoDut_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info0200" Style="{StaticResource CmdBox}" Text="47 4D 02 01 00" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="退出Dut模式" Style="{StaticResource CmdButton}" Click="ButtonOutDut_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="BT 测试"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info0c01" Style="{StaticResource CmdBox}" Text="47 4D 0c 01 01" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="进入BT测试" Style="{StaticResource CmdButton}" Click="ButtonGoBtTest_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info0c00" Style="{StaticResource CmdBox}" Text="47 4D 0c 01 00" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="退出BT测试" Style="{StaticResource CmdButton}" Click="ButtonOutBtTest_Click"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="2.4G 连接"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info03" Style="{StaticResource CmdBox}" Text="47 4D 03 00" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="断开2.4G" Style="{StaticResource CmdButton}" Click="ButtonDisConnect24G_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info04" Style="{StaticResource CmdBox}" Text="47 4D 04 00" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="搜索连接设备" Style="{StaticResource CmdButton}" Click="ButtonFindConnectDevice_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info05" Style="{StaticResource CmdBox}" Text="47 4D 05 06 请删除此部分并补充6位地址"/>
                            <Button x:Name="BtnCmd05" Grid.Column="1" Content="连接指定设备" Style="{StaticResource CmdButton}"
                                    Click="ButtonConnectOnlyDevice_Click" IsEnabled="False"/>
                        </Grid>

                        <TextBlock Style="{StaticResource SectionTitle}" Text="调试"/>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info06" Style="{StaticResource CmdBox}" Text="47 4D 06 N(hex) 请删除此部分并补充N位自定义数据"/>
                            <Button x:Name="BtnCmd06" Grid.Column="1" Content="自定义指令" Style="{StaticResource CmdButton}"
                                    Click="ButtonUserDefined_Click" IsEnabled="False"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info07" Style="{StaticResource CmdBox}" Text="47 4D 07 N(hex) 请删除此部分并补充N位透传数据"/>
                            <Button x:Name="BtnCmd07" Grid.Column="1" Content="透传耳机指令" Style="{StaticResource CmdButton}"
                                    Click="ButtonTrans_Click" IsEnabled="False"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info08" Style="{StaticResource CmdBox}" Text="47 4D 08 01 04" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="读取版本号" Style="{StaticResource CmdButton}" Click="ButtonGetVersion_Click"/>
                        </Grid>
                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="108"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="info10" Style="{StaticResource CmdBox}" Text="47 4D 0a 01 07" IsReadOnly="True"/>
                            <Button Grid.Column="1" Content="读取GUID" Style="{StaticResource CmdButton}" Click="ButtonGetGUID_Click"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
    </DockPanel>
</Window>
