<Window x:Class="AB.UsbDevicesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="USB 设备"
        Height="480"
        Width="740"
        MinHeight="360"
        MinWidth="560"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F8"
        ShowInTaskbar="False"
        PreviewKeyDown="Window_PreviewKeyDown">
    <DockPanel Margin="12">
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" Foreground="#6B7785" FontSize="12" Margin="0,0,0,10"
                   Text="可查看并删除系统里以前留下的 USB VID/PID 记录。删除需要管理员权限。"/>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" LastChildFill="False">
            <Button x:Name="BtnDelete" DockPanel.Dock="Left" Content="删除选中记录" Width="120" Height="28" Click="BtnDelete_Click"/>
            <Button DockPanel.Dock="Right" Content="关闭" Width="90" Height="28" IsCancel="True" Click="BtnClose_Click"/>
            <Button x:Name="BtnApply" DockPanel.Dock="Right" Content="填入并连接" Width="110" Height="28" Click="BtnApply_Click" Margin="0,0,8,0"/>
            <Button x:Name="BtnRefresh" DockPanel.Dock="Right" Content="刷新" Width="90" Height="28" Click="BtnRefresh_Click" Margin="0,0,8,0"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
            <CheckBox x:Name="ChkConnectedOnly" Content="仅已连接" IsChecked="False" VerticalAlignment="Center"
                      Checked="FilterChanged" Unchecked="FilterChanged"/>
            <CheckBox x:Name="ChkVid38A6" Content="仅 VID 38A6" IsChecked="True" VerticalAlignment="Center" Margin="16,0,0,0"
                      Checked="FilterChanged" Unchecked="FilterChanged"/>
            <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="16,0,0,0" Foreground="#6B7785"/>
        </StackPanel>
        <ListView x:Name="DeviceList" BorderBrush="#C5CDD6" BorderThickness="1"
                  SelectionMode="Extended"
                  MouseDoubleClick="DeviceList_MouseDoubleClick">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Connected}" Value="True">
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="状态" Width="70" DisplayMemberBinding="{Binding Status}"/>
                    <GridViewColumn Header="VID" Width="70" DisplayMemberBinding="{Binding Vid}"/>
                    <GridViewColumn Header="PID" Width="70" DisplayMemberBinding="{Binding Pid}"/>
                    <GridViewColumn Header="设备名称" Width="460" DisplayMemberBinding="{Binding Name}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
